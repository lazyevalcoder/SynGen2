# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Generated data & sessions (reproducible from configs)
sessions/
**/output/*.xlsx
tests/test_workbooks/
output_*.json
output_simdraft_debug.txt

# Per-flight benchmark dumps (regenerable; distilled record lives in
# experiments/fly_benchmark/findings_v4.md + findings_stage_diagnosis.md)
experiments/fly_benchmark/scenario_*_report.json
experiments/fly_benchmark/benchmark_report.json
experiments/fly_benchmark/run_*/

# Skills A/B raw outputs (regenerable)
experiments/skills_ab/

# OS / editor
Thumbs.db
.DS_Store

# LLM provider configs: real ones hold no secrets (keys come from env vars),
# but ignore them anyway; keep the *.example.json templates tracked.
llm_configs/*.json
!llm_configs/*.example.json

uat/

JUNK_NOT_PROJECT_RELATED/
output/
